{
  "name": "@omniroute/pi-agent",
  "version": "0.1.0",
  "description": "Pi extension for the OmniRoute AI Gateway. Registers OmniRoute's live model catalog (models + combos + server-declared effort tiers) as a Pi provider, with native metadata import and mid-session re-sync.",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "omniroute",
    "ai-gateway",
    "provider",
    "proxy",
    "combos"
  ],
  "author": "OmniRoute contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegosouzapw/OmniRoute.git",
    "directory": "@omniroute/pi-agent"
  },
  "bugs": {
    "url": "https://github.com/diegosouzapw/OmniRoute/issues"
  },
  "homepage": "https://github.com/diegosouzapw/OmniRoute/tree/main/%40omniroute/pi-agent#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@types/node": "^22.19.19",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
